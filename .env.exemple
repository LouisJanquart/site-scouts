# Copiez ce fichier en « .env » et remplissez-le.
# Le vrai .env ne doit JAMAIS être versionné : il contient les clés.

# --- Base de données --------------------------------------------------------
NUXT_BASE_URL=postgres://utilisateur:motdepasse@hote:5432/fleurus

# --- Chiffrement des fiches santé -------------------------------------------
# 32 octets en base64. À générer une fois :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# À sauvegarder ailleurs que sur le serveur : sans elle, les fiches santé sont
# définitivement illisibles.
NUXT_CLE_SANTE=

# --- Adresse publique du site ------------------------------------------------
NUXT_PUBLIC_URL_SITE=https://16efleurus.be

# --- Envoi des courriels (SMTP) ----------------------------------------------
NUXT_SMTP_HOTE=
NUXT_SMTP_PORT=587
NUXT_SMTP_TLS=starttls
NUXT_SMTP_UTILISATEUR=
NUXT_SMTP_MOTDEPASSE=
NUXT_SMTP_EXPEDITEUR="16e Fleurus <inscriptions@16efleurus.be>"

# --- Ménage RGPD sur un hébergement sans serveur -----------------------------
# Vercel, Netlify : le cron de l'hébergeur appelle /api/taches/menage avec ce
# secret. Sans lui, la route est fermée ET la purge ne tourne jamais.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# --- Paiement (Mollie) -------------------------------------------------------
# Tant qu'il n'y a pas de clé, mettre NUXT_PAIEMENT_DEMO=1 active un simulateur
# de paiement : le parcours complet, sans banque et sans un euro. Il est refusé
# en production, et ignoré dès qu'une clé Mollie est renseignée.
NUXT_PAIEMENT_DEMO=1

NUXT_MOLLIE_CLE=
# Adresse que Mollie appelle pour confirmer un paiement. Doit être joignable
# depuis l'extérieur : en développement, passer par un tunnel.
NUXT_MOLLIE_WEBHOOK=https://16efleurus.be/api/paiements/mollie


# --- Comptes de démonstration --------------------------------------------------
# Affiche sur la page de connexion les quatre comptes créés par
# « npm run base:semer -- --demo » (animé, parent, chef, CU ; le mot de passe est
# le nom du rôle). Ils ouvrent le back office, donc les fiches santé.
# À laisser VIDE partout où il y a de vraies familles, et à retirer de la base
# avec « npm run base:semer -- --sans-demo ».
NUXT_PUBLIC_COMPTES_DEMO=
