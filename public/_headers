# Nitro écrit déjà dans ce fichier, au moment du build, tout ce que déclarent
# les « routeRules » de nuxt.config.ts : le noindex, les en-têtes de sécurité
# et le cache des images. Ne pas les répéter ici — Netlify prévenait que le
# même en-tête était posé deux fois, une fois en « Cache-Control » et une fois
# en « cache-control ».
#
# Il ne reste donc que ce que les routeRules ne couvrent pas : les flux
# iCalendar, servis par le serveur mais dont le type doit être juste même
# quand un fichier passe par le CDN.
/calendriers/*
  content-type: text/calendar; charset=utf-8
  cache-control: public, max-age=3600
